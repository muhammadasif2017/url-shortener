{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // This project never emits. Node strips the types at runtime, so tsc is a
    // type checker and nothing else. allowImportingTsExtensions requires noEmit.
    "noEmit": true,
    "allowImportingTsExtensions": true,

    // erasableSyntaxOnly rejects any syntax that would need to be rewritten
    // rather than erased: enum, const enum, parameter properties, namespaces
    // with runtime code, and import aliases. verbatimModuleSyntax is what
    // actually enforces `import type` on type-only imports.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
