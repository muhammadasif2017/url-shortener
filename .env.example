# Copy this file to .env for local development, and to .env.test for tests.
# In .env.test, change the database name to urlshortener_test.
#
# Both files must exist before any npm script runs. `node --env-file` exits
# immediately when the file is missing. The `start` and `migrate` scripts use
# `--env-file-if-exists` instead, so they also work on a platform that injects
# these variables into the process environment rather than providing a file.

# One of: development, test, production
NODE_ENV=development

# Integer, 1 to 65535
PORT=3000

# Used to build shortUrl in API responses, and to reject links that point back
# at this service. No trailing slash.
BASE_URL=http://localhost:3000

# Host port 5433 is deliberate. 5432 is already taken on this machine.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/urlshortener

# Whether to connect to PostgreSQL over TLS. Defaults to true when NODE_ENV is
# production, false otherwise. Set it explicitly to run the production image
# against a local database, which offers no TLS.
# DATABASE_SSL=false

# Number of trusted proxies in front of this service.
# 0 locally, because nothing sits in front of it.
# On a platform that fronts your service with its own load balancers, set this
# to the real hop count. The client IP is then taken this many entries from the
# RIGHT-hand end of X-Forwarded-For. The left-hand entries are supplied by the
# caller and can say anything.
TRUST_PROXY_HOPS=0

# Salt for hashing visitor IP addresses in analytics. Generate 32 random bytes:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotating this resets unique-visitor counts, because the same visitor then
# hashes to a different value.
IP_HASH_SALT=replace-me-with-32-random-bytes-in-hex

# Rate limiting. Optional; these are the defaults.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Session lifetime in seconds. Optional; default is 7 days.
SESSION_TTL_SECONDS=604800

# Leave unset everywhere except local development and integration tests.
# When unset, GET /api/links and DELETE /api/links/:slug return 404.
# Until the identity module exists, those routes let anyone list every link
# and delete any of them.
# ENABLE_UNAUTHENTICATED_LINK_ADMIN=1
